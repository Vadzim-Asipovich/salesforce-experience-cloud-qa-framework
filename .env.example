# ─────────────────────────────────────────────────────────────────────────
# Environment profile. Selects a set of defaults from
# src/config/environments.ts: local | qa | staging | prod.
# Precedence: an explicit variable below wins; else the profile's value;
# else the schema default. So `TEST_ENV=qa` alone switches base URLs — as
# long as the profile-driven vars below stay commented out.
# ─────────────────────────────────────────────────────────────────────────
TEST_ENV=local

# ─────────────────────────────────────────────────────────────────────────
# Profile-driven — leave commented to let TEST_ENV decide. Uncomment only
# to pin a value regardless of profile.
#
#   UI_BASE_URL       real, public Salesforce Experience Cloud (Lightning)
#                     site. `local`/`prod` → ideas.salesforce.com.
#   USE_MOCK_SF_API   true  → bundled mock (no org, no secrets needed)
#                     false → real org via the SF_* vars below
#   SF_LOGIN_URL      test.salesforce.com (sandbox) | login.salesforce.com
# ─────────────────────────────────────────────────────────────────────────
# UI_BASE_URL=https://ideas.salesforce.com
# USE_MOCK_SF_API=true
# SF_LOGIN_URL=https://test.salesforce.com

# ─────────────────────────────────────────────────────────────────────────
# Salesforce REST API — JWT Bearer flow (server-to-server, CI-friendly,
# no interactive login/refresh token needed). Only required when the
# effective USE_MOCK_SF_API is false, i.e. pointing the API suite at a real
# org (the `qa` / `staging` profiles do this).
# ─────────────────────────────────────────────────────────────────────────
SF_API_VERSION=61.0
SF_CLIENT_ID=
SF_USERNAME=
# Path to the private key paired with the Connected App's uploaded
# certificate. Never commit the key itself — see docs/ARCHITECTURE.md.
SF_JWT_PRIVATE_KEY_PATH=./secrets/server.key

# ─────────────────────────────────────────────────────────────────────────
# Built-in mock Salesforce REST API (src/mocks/salesforce-mock-server.ts).
# Started automatically by Playwright's globalSetup — override the port
# only if it collides with something else on your machine.
# ─────────────────────────────────────────────────────────────────────────
MOCK_SF_API_PORT=4010

# Misc
CI=false
LOG_LEVEL=info
